{
  "version": 2,
  "builds": [
    
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "outputDirectory": "build" 
      }
    },
   
    {
      "src": "Dockerfile", 
      "use": "@vercel/docker" 
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "index" 
    },
  
    {
      "src": "/", 
      "dest": "frontend/build/index.html" 
    },
    {
      "src": "/(.*)", 
      "dest": "frontend/build/$1" 
    }
  ]
}